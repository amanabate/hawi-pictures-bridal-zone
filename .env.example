# ==============================================================================
# Hawi Pictures & Bridal Zone - Environment Configuration (.env.example)
# Wedding Photography, Bridal Salon & Aadaa Cultural Wear (Ethiopia)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Supabase Project Configuration
# ------------------------------------------------------------------------------
# Public Supabase URL (e.g. https://xyzcompany.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Public Anon API Key (safe for client-side browser requests protected by RLS)
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Supabase Service Role Key (SERVER-SIDE ONLY - NEVER EXPOSE TO CLIENT)
# Used by Next.js Route Handlers for atomic booking transactions, storage signing, and cron jobs.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# PostgreSQL Connection URI for running migrations via psql or Supabase CLI
DATABASE_URL=postgresql://postgres.your-project:password@aws-0-eu-central-1.pooler.supabase.com:6543/postgres

# ------------------------------------------------------------------------------
# 2. Studio Administration PINs
# ------------------------------------------------------------------------------
# Owner PIN (Full control: pricing, staff roles, capacity overrides, audit log)
ADMIN_OWNER_PIN=hawi2026

# Receptionist PIN (Bookings, calendar, gallery, client notifications)
ADMIN_RECEPTIONIST_PIN=reception123

# Staff PIN (Assigned shoots, media upload)
ADMIN_STAFF_PIN=staff123

# ------------------------------------------------------------------------------
# 3. Telegram Integration (Server-side Bot Alerts)
# ------------------------------------------------------------------------------
# Telegram Bot Token from @BotFather
TELEGRAM_BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ

# Studio Owner Chat ID for instant new booking alerts and hold reminders
TELEGRAM_OWNER_CHAT_ID=987654321

# ------------------------------------------------------------------------------
# 4. Storage Buckets
# ------------------------------------------------------------------------------
SUPABASE_SCREENSHOTS_BUCKET=payment-screenshots
SUPABASE_GALLERY_BUCKET=gallery

# ------------------------------------------------------------------------------
# 5. Application Settings
# ------------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=https://hawipictures.et
PORT=3000
