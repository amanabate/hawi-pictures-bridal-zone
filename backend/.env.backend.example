# ==============================================================================
# Hawi Pictures & Bridal Zone - Backend Environment Configuration
# 🔒 SERVER-SIDE SECRETS ONLY - NEVER EXPOSE TO CLIENT
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Supabase Service Role Key (SERVER-SIDE ONLY)
# ------------------------------------------------------------------------------
# Used by Next.js Route Handlers for atomic booking transactions, 
# storage signing, and cron jobs.
# ⚠️ NEVER expose this key to the browser or commit to git
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ------------------------------------------------------------------------------
# 2. PostgreSQL Connection URI
# ------------------------------------------------------------------------------
# For running migrations via psql or Supabase CLI
DATABASE_URL=postgresql://postgres.your-project:password@aws-0-eu-central-1.pooler.supabase.com:6543/postgres

# ------------------------------------------------------------------------------
# 3. Studio Administration PINs
# ------------------------------------------------------------------------------
# Owner PIN (Full control: pricing, staff roles, capacity overrides, audit log)
ADMIN_OWNER_PIN=hawi2026

# Receptionist PIN (Bookings, calendar, gallery, client notifications)
ADMIN_RECEPTIONIST_PIN=reception123

# Staff PIN (Assigned shoots, media upload)
ADMIN_STAFF_PIN=staff123

# ------------------------------------------------------------------------------
# 4. Telegram Integration (Server-side Bot Alerts)
# ------------------------------------------------------------------------------
# Telegram Bot Token from @BotFather
TELEGRAM_BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ

# Studio Owner Chat ID for instant new booking alerts and hold reminders
TELEGRAM_OWNER_CHAT_ID=987654321

# ------------------------------------------------------------------------------
# 5. Storage Buckets
# ------------------------------------------------------------------------------
SUPABASE_SCREENSHOTS_BUCKET=payment-screenshots
SUPABASE_GALLERY_BUCKET=gallery
