# ==============================================================================
# Hawi Pictures & Bridal Zone - Frontend Environment Configuration
# ⚠️ PUBLIC KEYS ONLY (Safe for browser/client-side)
# Wedding Photography, Bridal Salon & Aadaa Cultural Wear (Ethiopia)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Supabase Public Configuration (CLIENT-SIDE SAFE)
# ------------------------------------------------------------------------------
# Public Supabase URL (e.g. https://xyzcompany.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Public Anon API Key (safe for client-side browser requests protected by RLS)
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ------------------------------------------------------------------------------
# 2. Application Settings (CLIENT-SIDE SAFE)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=https://hawipictures.et

# ------------------------------------------------------------------------------
# ⚠️ IMPORTANT: Server-Side Secrets
# ------------------------------------------------------------------------------
# For server-side secrets (service role keys, admin PINs, Telegram tokens),
# see: ../backend/.env.backend.example
# 
# These should NEVER be prefixed with NEXT_PUBLIC_ and should only be 
# accessed from Next.js API routes or server components.
# ------------------------------------------------------------------------------
