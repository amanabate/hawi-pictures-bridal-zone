{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "baseUrl": ".",
    "paths": {
      "@/*": ["./*"],
      "@/components/layout/*": ["./components/layout/*"],
      "@/components/features/*": ["./components/features/*"],
      "@/components/home/*": ["./components/features/home/*"],
      "@/components/admin/*": ["./components/features/admin/*"],
      "@/components/booking/*": ["./components/features/booking/*"],
      "@/components/packages/*": ["./components/features/packages/*"],
      "@/components/pwa/*": ["./components/features/pwa/*"],
      "@/components/ui/*": ["./components/ui/*"],
      "@/components/*": ["./components/*", "./components/layout/*", "./components/features/*"],
      "@/lib/language-context": ["./lib/context/language-context"],
      "@/lib/supabase/*": ["../backend/lib/supabase/*"],
      "@/hooks/*": ["./lib/hooks/*"],
      "@/lib/*": [
        "./lib/*",
        "./lib/context/*",
        "./lib/stores/*",
        "./lib/hooks/*",
        "./lib/i18n/*"
      ],
      "@/data/*": ["./constants/*"],
      "@/tests/*": ["../backend/tests/*"],
      "@/backend/*": ["../backend/*"]
    }
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts"],
  "exclude": ["node_modules"]
}
